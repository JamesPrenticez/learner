{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=learner.db"
  },
  "Competency": {
    "DemonstratedThreshold": 0.8,
    "MinEvidence": 2,
    "RecentEvidence": 5,
    "SourceWeights": { "quiz": 1, "exercise": 1.5 }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  }
}
