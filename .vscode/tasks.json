{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: build",
      "type": "shell",
      "command": "dotnet build backend/Learner.slnx",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: watch",
      "type": "shell",
      "command": "dotnet watch run --project backend/src/Learner.Api",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "api: test",
      "type": "shell",
      "command": "dotnet test backend/Learner.slnx",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: dev",
      "type": "shell",
      "command": "pnpm --dir frontend dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
